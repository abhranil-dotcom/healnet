# Set these in Render → Service → Environment. (The server does not load .env files itself.)
# PORT is provided by Render automatically; 4000 is the local fallback.
PORT=4000
# Comma-separated frontend origins allowed by CORS / Socket.IO (local Vite origins are always allowed).
# Wildcards are supported, e.g. https://healnet-*.vercel.app for preview deployments.
FRONTEND_URL=https://your-app.vercel.app
