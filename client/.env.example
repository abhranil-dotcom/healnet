# Copy to .env.local for local overrides, or set these in Vercel → Project → Settings → Environment Variables.
# Vite embeds them at BUILD time: redeploy after changing them.
# Defaults (when unset): http://localhost:4000 in `npm run dev`; the page's own origin in a production build.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
